#!/bin/bash
set -uo pipefail

if [ -x /usr/local/bin/sing-box ]; then
  /usr/local/bin/sing-box version | head -1 || true
else
  echo 'sing-box binary: missing'
fi

route=$(ip -4 route get 1.1.1.1 2>/dev/null || true)
lan_ip=$(awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}' <<<"$route")
if [ -z "$lan_ip" ]; then
  lan_ip=$(ip -4 -o addr show scope global | awk '{split($4, address, "/"); if (address[1] !~ /^169\.254\./) {print address[1]; exit}}')
fi
if [ -n "$lan_ip" ]; then
  echo "Rule UI: http://$lan_ip:9091"
else
  echo 'Rule UI: LAN address unavailable; check the network configuration.'
fi

token_file=/etc/sing-box/rule-ui/token
if [ -s "$token_file" ] && [ -r "$token_file" ]; then
  printf 'UI password/token: %s\n' "$(<"$token_file")"
else
  echo "UI password/token: unavailable ($token_file missing or unreadable)"
fi

echo 'Services:'
for service in sing-box sing-box-tproxy singbox-rule-ui; do
  status=$(systemctl is-active "$service" 2>/dev/null || true)
  printf '  %s: %s\n' "$service" "${status:-unknown}"
done
echo 'Automatic proxy learning:'
systemctl is-active sing-box-auto-proxy-learning.timer 2>/dev/null || true
/usr/local/sbin/sing-box-auto-proxy-learn --status 2>/dev/null || true
echo '  Pause/resume/clear: sing-box-auto-proxy-learn --disable | --enable | --clear'

echo 'Config check:'
if [ -x /usr/local/bin/sing-box ]; then
  /usr/local/bin/sing-box check -c /etc/sing-box/config.json || true
fi
echo 'Common commands:'
echo '  sing-box-gateway-info'
echo '  systemctl status sing-box sing-box-tproxy singbox-rule-ui sing-box-auto-proxy-learning.timer'
echo '  journalctl -u sing-box -u sing-box-tproxy -u singbox-rule-ui -e'
echo '  sing-box-gateway-uninstall'
echo 'Logs: journalctl -u sing-box -u singbox-rule-ui -e'
systemctl --no-pager list-timers update-sing-box-rules.timer monitor-sing-box-runtime.timer sing-box-auto-proxy-learning.timer || true
python3 - <<'PY'
import json
from pathlib import Path

config = json.loads(Path("/etc/sing-box/config.json").read_text())
groups_path = Path("/etc/sing-box/manager/groups.json")
groups = json.loads(groups_path.read_text()) if groups_path.exists() else {}
fakeip = next((item for item in config.get("dns", {}).get("servers", []) if item.get("type") == "fakeip"), {})
ipv6_dns = next((item.get("listen") for item in config.get("inbounds", []) if item.get("tag") == "dns-in-v6"), "")
ipv6_enabled = groups.get("fakeip", {}).get("ipv6_enabled", True) is not False
print("FakeIP routes:")
if fakeip.get("inet4_range"):
    print(f"  IPv4 {fakeip['inet4_range']} -> use this gateway's LAN IPv4")
if ipv6_enabled and fakeip.get("inet6_range"):
    next_hop = ipv6_dns or "<no ULA DNS listener detected>"
    print(f"  IPv6 {fakeip['inet6_range']} -> {next_hop}")
    if not ipv6_dns:
        print("  Add a reachable LAN ULA to this gateway and configure the upstream route, or disable IPv6 FakeIP / AAAA in Rule UI.")
    else:
        print("  Configure the upstream router to route this IPv6 range to the ULA shown above.")
elif fakeip.get("inet6_range"):
    print("  IPv6 FakeIP / AAAA is disabled in Rule UI.")
PY
