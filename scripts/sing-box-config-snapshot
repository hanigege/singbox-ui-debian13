#!/bin/bash
# 每日配置快照：打包 manager 源配置与当前运行时配置，便于整机回滚。
# 只备配置不备凭据：不含 rule-ui token、不含规则库（可由定时任务重新拉取）。
set -euo pipefail

BACKUP_DIR="/etc/sing-box/manager/backups"
mkdir -p "$BACKUP_DIR"
TS="$(date +%Y%m%d-%H%M%S)"
TARGET="$BACKUP_DIR/config-snapshot-$TS.tar.gz"

tar -czf "$TARGET" \
  -C / \
  etc/sing-box/manager/base.json \
  etc/sing-box/manager/groups.json \
  etc/sing-box/manager/nodes.json \
  etc/sing-box/config.json
chmod 600 "$TARGET"

# 只保留最近 7 份快照
ls -1t "$BACKUP_DIR"/config-snapshot-*.tar.gz 2>/dev/null | tail -n +8 | xargs -r rm -f
echo "snapshot written: $TARGET"
