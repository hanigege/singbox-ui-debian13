[Unit]
Description=sing-box TProxy nftables and policy routing
Wants=network-online.target
After=network-online.target nftables.service
Before=sing-box.service

[Service]
Type=oneshot
RemainAfterExit=true
EnvironmentFile=-/etc/default/singbox-gateway
ExecStartPre=/usr/local/sbin/refresh-sing-box-tproxy-setup
ExecStart=/usr/local/sbin/sing-box-tproxy-setup
ExecStop=/usr/local/sbin/stop-sing-box-tproxy
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
