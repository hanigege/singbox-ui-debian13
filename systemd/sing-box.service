[Unit]
Description=sing-box gateway
Wants=network-online.target sing-box-tproxy.service
After=network-online.target sing-box-tproxy.service

[Service]
Type=simple
WorkingDirectory=/etc/sing-box
ExecStartPre=/usr/local/sbin/refresh-sing-box-runtime-config --startup
ExecStart=/usr/local/bin/sing-box run -c /etc/sing-box/config.json
ExecStartPost=/usr/local/sbin/refresh-sing-box-runtime-config --startup-ready
ExecStopPost=/usr/local/sbin/refresh-sing-box-runtime-config --startup-stopped
Restart=on-failure
RestartSec=3
TimeoutStartSec=35s
RuntimeDirectory=sing-box-startup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
